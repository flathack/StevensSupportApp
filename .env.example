# Public deployment example for ghcr.io/flathack/stevens-support-app
# Replace all placeholder values before production use.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# Example application settings. Keep real secrets outside version control.
StevensSupport__StoragePath=/data/server-state.db
StevensSupport__PublicBaseUrl=http://localhost:5000
StevensSupport__AdminApiKey=change-me
StevensSupport__RegistrationSharedKey=change-me
