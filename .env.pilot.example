SERVICEHUB_IMAGE=ghcr.io/flathack/flathack-servicehub:pilot
SERVICEHUB_API_BIND=127.0.0.1
SERVICEHUB_API_PORT=5000
SERVICEHUB_WEB_BIND=127.0.0.1
SERVICEHUB_WEB_PORT=5001
SERVICEHUB_JWT_SECRET=generated-by-bootstrap-script
SERVICEHUB_BOOTSTRAP_ENABLED=true
SERVICEHUB_BOOTSTRAP_USERNAME=admin
SERVICEHUB_BOOTSTRAP_PASSWORD_FILE=./secrets/bootstrap-password.txt
SERVICEHUB_BOOTSTRAP_DISPLAY_NAME=Pilot Administrator
SERVICEHUB_REQUIRE_ADMIN_MFA=false
SERVICEHUB_REQUIRE_RECENT_BACKUP=false
SERVICEHUB_BACKUP_MAX_AGE_HOURS=26
